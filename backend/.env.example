# App Settings
APP_NAME="Healthy Home Foods"
APP_ENV="development"
DEBUG=True
SECRET_KEY="replace_me_with_a_secure_random_string"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
API_V1_PREFIX="/api/v1"

# Database Configuration (Docker Compose Defaults)
DATABASE_URL="postgresql+asyncpg://hhf_user:hhf_password@db:5432/healthy_home_foods"
SYNC_DATABASE_URL="postgresql://hhf_user:hhf_password@db:5432/healthy_home_foods"

# Redis / Celery
REDIS_URL="redis://localhost:6379/0"
CELERY_BROKER_URL="redis://localhost:6379/1"
CELERY_RESULT_BACKEND="redis://localhost:6379/2"

# OTP (MSG91)
OTP_PROVIDER="msg91"
MSG91_AUTH_KEY=""
MSG91_TEMPLATE_ID=""
MSG91_SENDER_ID="HHFOTP"
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=3

# Email (SMTP)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USERNAME=""
SMTP_PASSWORD=""
EMAIL_FROM="noreply@healthyhomefoods.com"
EMAIL_FROM_NAME="Healthy Home Foods"

# Payments (Razorpay)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Maps
GOOGLE_MAPS_API_KEY=""

# Firebase
FIREBASE_CREDENTIALS_PATH="./firebase-credentials.json"

# Defaults
DEFAULT_FREE_DELIVERY_RADIUS_KM=5.0
DEFAULT_DELIVERY_CHARGE_PER_KM=10.0
DEFAULT_TAX_PERCENTAGE=0.0

# Uploads
UPLOAD_DIR="./uploads"
MAX_UPLOAD_SIZE_MB=5
