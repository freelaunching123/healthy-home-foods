# ─────────────────────────────────────────
# App
# ─────────────────────────────────────────
APP_NAME="Healthy Home Foods"
APP_ENV=development          # development | production
DEBUG=True
SECRET_KEY=change-me-to-a-long-random-secret-key-at-least-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
API_V1_PREFIX=/api/v1
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ─────────────────────────────────────────
# Database
# ─────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://hhf_user:hhf_password@localhost:5432/hhf_db
SYNC_DATABASE_URL=postgresql://hhf_user:hhf_password@localhost:5432/hhf_db

# ─────────────────────────────────────────
# Redis
# ─────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ─────────────────────────────────────────
# OTP (MSG91)
# ─────────────────────────────────────────
OTP_PROVIDER=msg91              # msg91 | twilio | email
MSG91_AUTH_KEY=your-msg91-auth-key
MSG91_TEMPLATE_ID=your-otp-template-id
MSG91_SENDER_ID=HHFOTP
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=3

# ─────────────────────────────────────────
# Email (SMTP)
# ─────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=noreply@healthyhomefoods.com
EMAIL_FROM_NAME="Healthy Home Foods"

# ─────────────────────────────────────────
# Payments (Razorpay)
# ─────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-secret
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret

# ─────────────────────────────────────────
# Google Maps
# ─────────────────────────────────────────
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# ─────────────────────────────────────────
# Firebase (FCM Push Notifications)
# ─────────────────────────────────────────
FIREBASE_CREDENTIALS_PATH=./firebase-credentials.json

# ─────────────────────────────────────────
# Business Defaults (overridden by admin_settings)
# ─────────────────────────────────────────
DEFAULT_FREE_DELIVERY_RADIUS_KM=5.0
DEFAULT_DELIVERY_CHARGE_PER_KM=10.0
DEFAULT_TAX_PERCENTAGE=0.0

# ─────────────────────────────────────────
# File Upload
# ─────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=5
